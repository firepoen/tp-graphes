graph {
    node [shape="star" style="filled" fillcolor="aqua"];
    edge [fontsize="20pt" color="red"];

    A [pos="0,4!"];
    B [pos="2,5!"];
    C [pos="2,2!"];
    D [pos="4,3!"];
    E [pos="6,1!"];
    F [pos="6,3!"];
    G [pos="8,5!"];

    A -- B [label="2"];
    A -- C [label="3"];
    B -- D [label="5"];
    B -- G [label="4"];
    C -- D [label="1"];
    C -- E [label="6"];
    D -- F [label="2"];
    E -- F [label="3"];
    F -- G [label="4"];
}
